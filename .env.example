# Copy to .env for local dev. No secrets here: auth is via Application Default Credentials.
GOOGLE_CLOUD_PROJECT=project-d5fe6dd3-2b61-40b3-932

# Gemini on Vertex AI. The newest models (gemini-3.x / 3.8-flash) are only served from the
# "global" endpoint; a regional location like us-central1 returns 404 for them.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# Legacy name, still read by older SDKs
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Where Cloud Run, Firestore, Artifact Registry etc. live.
GCP_REGION=us-central1

# Local only: the project-scoped ADC file (on Cloud Run, the service account is used instead).
GOOGLE_APPLICATION_CREDENTIALS=$HOME/.config/gcloud-hack2skill-adc/application_default_credentials.json
